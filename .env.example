# ==============================
# APPLICATION
# ==============================
FLASK_ENV=development
SECRET_KEY=change-this-before-production
HOST=127.0.0.1
PORT=5000
PILOT_STATE=Madhya Pradesh
DATA_MODE=LOCAL
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DATA_DIR=data/reports
DATABASE_URL=sqlite:///data/database/climatwin.db
MODELS_DIR=models
ML_REPORTS_DIR=reports/ml
# Software/UX bounds for experimental scenario exploration, not scientific limits.
SCENARIO_TEMPERATURE_MIN=-5
SCENARIO_TEMPERATURE_MAX=5
SCENARIO_RAINFALL_MIN=-50
SCENARIO_RAINFALL_MAX=50
SCENARIO_HUMIDITY_MIN=-30
SCENARIO_HUMIDITY_MAX=30

# ==============================
# MOSDAC / ISRO (Now used for NASA Earthdata / CMR)
# ==============================
MOSDAC_API_URL=https://cmr.earthdata.nasa.gov/search/granules.json
MOSDAC_API_KEY=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_DATASET_ID=C1748058432-LPCLOUD

# ==============================
# IMD (Now used for Open-Meteo)
# ==============================
IMD_API_URL=https://api.open-meteo.com/v1/forecast
IMD_API_KEY=
IMD_USERNAME=
IMD_PASSWORD=
IMD_DATASET_ID=
# ==============================
# MAP PROVIDER (OPTIONAL FUTURE)
# ==============================
MAP_STYLE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_PROVIDER_TOKEN=
MAP_SATELLITE_STYLE_URL=
MAP_TERRAIN_DEM_URL=
OPENTOPOGRAPHY_API_KEY=
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
GEOCODING_API_KEY=
